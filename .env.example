# Local PostgreSQL container configuration. Copy to .env and choose a password.
BIC_POSTGRES_DB=bilingual_interview_coach
BIC_POSTGRES_USER=bic_app
BIC_POSTGRES_PASSWORD=replace-with-a-local-development-password
BIC_POSTGRES_PORT=5433

# Used by the interview service and Alembic. Keep this synchronized with the
# values above; URL-encode special characters in the password.
DATABASE_URL=postgresql+psycopg://bic_app:replace-with-a-local-development-password@127.0.0.1:5433/bilingual_interview_coach

# Public API connection to the Interview Service.
INTERVIEW_SERVICE_URL=http://127.0.0.1:8001

# AI provider. "mock" is deterministic, local, and makes no network calls.
AI_PROVIDER=mock
AI_QUESTION_LIMIT=5
AI_TIMEOUT_SECONDS=20
AI_MAX_RETRIES=1

# The standalone paid-provider smoke script also requires this to be changed to
# 1 and an explicit command-line confirmation. It is never used by pytest/CI.
LIVE_PROVIDER_SMOKE_ENABLED=0

# Required only when AI_PROVIDER=openai. Select a model available to your own
# OpenAI project; the application deliberately does not hardcode a model ID.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1

# LiveKit Cloud or the optional local voice profile. Generate a unique local
# key/secret; do not use placeholders outside an isolated development machine.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=bic-interviewer
LIVEKIT_TOKEN_TTL_SECONDS=600

# Speech is deliberately separate from AI_PROVIDER. "fake" is test-only and
# makes no provider calls. Select a real provider only for an explicitly
# configured worker.
VOICE_AUDIO_PROVIDER=fake
VOICE_STT_TIMEOUT_SECONDS=10
VOICE_TTS_TIMEOUT_SECONDS=10
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
GOOGLE_STT_LOCATION=global
GOOGLE_STT_MODEL_EN=latest_long
GOOGLE_STT_MODEL_SI=chirp_2
GOOGLE_TTS_MODEL=gemini-2.5-flash-tts
GOOGLE_TTS_VOICE_EN=Kore
# Required for Sinhala: choose and validate an si-LK voice available to the
# configured Google project/region. Availability does not imply quality.
GOOGLE_TTS_VOICE_SI=

# LiveKit Cloud Inference. Use Cloud project credentials, not local server keys.
# Inference is an audio provider only; AI_PROVIDER=mock remains supported.
LIVEKIT_INFERENCE_API_KEY=
LIVEKIT_INFERENCE_API_SECRET=
LIVEKIT_INFERENCE_STT_MODEL_EN=deepgram/nova-3
LIVEKIT_INFERENCE_STT_MODEL_SI=cartesia/ink-whisper
LIVEKIT_INFERENCE_TTS_MODEL=google/gemini-3.8-flash-lite-tts
LIVEKIT_INFERENCE_TTS_VOICE_EN=Kore
LIVEKIT_INFERENCE_TTS_VOICE_SI=Kore

